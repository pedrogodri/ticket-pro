      "properties": {
        "orderId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "userId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "eventId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "sectorId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "quantity": {
          "$ref": "../../common.schema.json#/$defs/quantity"
        }
      }
    }
  }
}
