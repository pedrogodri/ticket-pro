{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingressoja.local/contracts/events/TokenRevoked/v1.schema.json",
  "title": "TokenRevoked v1",
  "description": "Access token revogado; o gateway copia o jti para sua blacklist até expiresAt.",
  "x-topic": "ingressoja-auth",
  "x-producer": "auth-service",
  "x-consumers": [
    "gateway"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "TokenRevoked"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jti",
        "userId",
        "expiresAt",
        "reason"
      ],
      "properties": {
        "jti": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "userId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "expiresAt": {
          "$ref": "../../common.schema.json#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "enum": [
            "LOGOUT",
            "ACCOUNT_REMOVED",
            "REFRESH_REUSE"
          ]
        }
      }
    }
  }
}
