{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingressoja.local/contracts/events/InventoryReservationExpired/v1.schema.json",
  "title": "InventoryReservationExpired v1",
  "description": "Reserva pendente expirou e o estoque foi devolvido; o order cancela se ainda não estiver em estado final.",
  "x-topic": "ingressoja-inventory",
  "x-producer": "inventory-service",
  "x-consumers": [
    "order-service"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "InventoryReservationExpired"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "reservationId",
        "quantity"
      ],
      "properties": {
        "orderId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "reservationId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "quantity": {
          "$ref": "../../common.schema.json#/$defs/quantity"
        }
      }
    }
  }
}
