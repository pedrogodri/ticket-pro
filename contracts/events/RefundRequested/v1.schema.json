{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticketpro.local/contracts/events/RefundRequested/v1.schema.json",
  "title": "RefundRequested v1",
  "description": "Comando de estorno para aprovação que chegou após o cancelamento do pedido.",
  "x-topic": "ticketpro-orders",
  "x-producer": "order-service",
  "x-consumers": [
    "payment-service"
  ],
  "type": "object",
  "allOf": [
    {
      "$ref": "../../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "RefundRequested"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "paymentId",
        "amountCents",
        "currency",
        "reason"
      ],
      "properties": {
        "orderId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "paymentId": {
          "$ref": "../../common.schema.json#/$defs/uuid"
        },
        "amountCents": {
          "$ref": "../../common.schema.json#/$defs/amountCents"
        },
        "currency": {
          "$ref": "../../common.schema.json#/$defs/currency"
        },
        "reason": {
          "type": "string",
          "enum": [
            "LATE_APPROVAL"
          ]
        }
      }
    }
  }
}
