{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticketpro.local/contracts/common.schema.json",
  "title": "Tipos comuns dos contratos do Ticket Pro",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 em UTC, com milissegundos."
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "amountCents": {
      "type": "integer",
      "minimum": 0,
      "description": "Valor monetário em centavos."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Código ISO 4217."
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Ingressos por pedido (ORDER_MAX_QUANTITY)."
    }
  }
}
