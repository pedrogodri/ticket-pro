{
  "name": "@ticketpro/order-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ticket Pro order-service: async order API and purchase saga orchestrator.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write . && eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1159.0",
    "@aws-sdk/client-sqs": "3.1159.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@smithy/node-http-handler": "4.14.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "^5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "testcontainers": "12.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
