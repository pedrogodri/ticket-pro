# orders-db and order-service-migrate only (ADR-0020). DEVELOPMENT ONLY: never reuse these passwords.
POSTGRES_USER=orders_owner
POSTGRES_PASSWORD=orders_owner_dev
POSTGRES_DB=orders

FLYWAY_URL=jdbc:postgresql://orders-db:5432/orders
FLYWAY_USER=orders_owner
