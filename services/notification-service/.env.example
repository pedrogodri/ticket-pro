# notification-service runtime configuration. DEVELOPMENT ONLY: credentials are fake.
SERVICE_NAME=notification-service
PORT=8080
LOG_LEVEL=info

# Postgres (docs/padroes.md §6.1): API role (RLS) and worker role (consumers, jobs).
DATABASE_URL=postgres://notifications_app:notifications_app_dev@notifications-db:5432/notifications?sslmode=disable
DATABASE_WORKER_URL=postgres://notifications_worker:notifications_worker_dev@notifications-db:5432/notifications?sslmode=disable

# AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_URL=http://ministack:4566/000000000000/ticketpro-notification-service
RECEIPTS_BUCKET=ticketpro-receipts
CONTRACTS_DIR=/contracts
HTTP_CLIENT_TIMEOUT_MS=3000

# SQS consumer (RFC 0003 §5.1).
CONSUMER_CONCURRENCY=4
SQS_WAIT_TIME_S=10

# Tracing (ADR-0012): OTLP/gRPC to the collector; empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
