SERVICE_NAME=autoscaler
PORT=8080
LOG_LEVEL=info

# Queue-depth autoscaling (ADR-0015). AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AUTOSCALER_TARGETS=payment-service=ticketpro-payment-service
AUTOSCALER_INTERVAL_S=5
AUTOSCALER_MSGS_PER_REPLICA=5
AUTOSCALER_MIN_REPLICAS=2
AUTOSCALER_MAX_REPLICAS=5
AUTOSCALER_COOLDOWN_S=30
COMPOSE_PROJECT_NAME=ticketpro
DOCKER_HOST=unix:///var/run/docker.sock
HTTP_CLIENT_TIMEOUT_MS=3000
