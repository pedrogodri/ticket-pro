# inventory-service runtime configuration. DEVELOPMENT ONLY: credentials are fake.
SERVICE_NAME=inventory-service
PORT=8080
LOG_LEVEL=info

# Postgres (docs/padroes.md §6.1): API role (RLS) and worker role (relay, consumers, jobs).
DATABASE_URL=postgres://inventory_app:inventory_app_dev@inventory-db:5432/inventory?sslmode=disable
DATABASE_WORKER_URL=postgres://inventory_worker:inventory_worker_dev@inventory-db:5432/inventory?sslmode=disable

# AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INVENTORY_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticketpro-inventory
QUEUE_URL=http://ministack:4566/000000000000/ticketpro-inventory-service
CONTRACTS_DIR=/contracts

# Outbox relay and HTTP client (RFC 0003 §5.1 defaults).
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_MS=30000
OUTBOX_CLAIM_LEASE_MS=30000
HTTP_CLIENT_TIMEOUT_MS=3000
