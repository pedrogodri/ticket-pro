# inventory-db and inventory-migrate only (ADR-0020). DEVELOPMENT ONLY: never reuse these passwords.
POSTGRES_USER=inventory_owner
POSTGRES_PASSWORD=inventory_owner_dev
POSTGRES_DB=inventory

FLYWAY_URL=jdbc:postgresql://inventory-db:5432/inventory
FLYWAY_USER=inventory_owner
FLYWAY_PASSWORD=inventory_owner_dev
FLYWAY_CONNECT_RETRIES=10
# Placeholders used by V0001__create_roles.sql; must match the passwords in .env.example.
FLYWAY_PLACEHOLDERS_APP_PASSWORD=inventory_app_dev
FLYWAY_PLACEHOLDERS_WORKER_PASSWORD=inventory_worker_dev
