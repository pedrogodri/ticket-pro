# payments-db and payment-service-migrate only (ADR-0020). DEVELOPMENT ONLY: never reuse these passwords.
POSTGRES_USER=payments_owner
POSTGRES_PASSWORD=payments_owner_dev
POSTGRES_DB=payments

FLYWAY_URL=jdbc:postgresql://payments-db:5432/payments
FLYWAY_USER=payments_owner
FLYWAY_PASSWORD=payments_owner_dev
FLYWAY_CONNECT_RETRIES=10
