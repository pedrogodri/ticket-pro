# payment-service runtime configuration. DEVELOPMENT ONLY: credentials are fake.
SERVICE_NAME=payment-service
PORT=8080
LOG_LEVEL=info

# Postgres (docs/padroes.md §6.1): API role (RLS) and worker role (relay, consumers, jobs).
DATABASE_URL=postgres://payments_app:payments_app_dev@payments-db:5432/payments?sslmode=disable
DATABASE_WORKER_URL=postgres://payments_worker:payments_worker_dev@payments-db:5432/payments?sslmode=disable

# AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PAYMENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticketpro-payments
QUEUE_URL=http://ministack:4566/000000000000/ticketpro-payment-service
CONTRACTS_DIR=/contracts

# Outbox relay and HTTP client (RFC 0003 §5.1 defaults).
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_MS=30000
OUTBOX_CLAIM_LEASE_MS=30000
HTTP_CLIENT_TIMEOUT_MS=3000
