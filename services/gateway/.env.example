SERVICE_NAME=gateway
PORT=8080
LOG_LEVEL=info

# Routing and JWT validation (RFC 0002 §5.5). First path segment → upstream.
GATEWAY_ROUTES=auth=http://auth-service:8080,me=http://user-service:8080,orders=http://order-service:8080,events=http://inventory-service:8080
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
JWT_ISSUER=ticketpro-auth
JWT_AUDIENCE=ticketpro-api
JWKS_CACHE_TTL_S=300
JWT_CLOCK_SKEW_S=30
GATEWAY_MAX_BODY_BYTES=65536
GATEWAY_UPSTREAM_TIMEOUT_MS=5000

# Own Redis (ADR-0014): revocation blacklist and rate limit. Fail-open past REDIS_TIMEOUT_MS.
REDIS_URL=redis://gateway-redis:6379/0
REDIS_TIMEOUT_MS=200
# After a Redis failure, skip the checks (fail-open) for this long instead of timing out per request.
REDIS_COOLDOWN_MS=5000

# TokenRevoked consumer (ADR-0014). AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_URL=http://ministack:4566/000000000000/ticketpro-gateway
CONTRACTS_DIR=/contracts
SQS_WAIT_TIME_S=10
HTTP_CLIENT_TIMEOUT_MS=3000

# Rate limit (RFC 0002 §5.8): token bucket per user (default), per IP on public routes,
# stricter on POST /auth/login (per IP) and POST /orders (per user). 429 + Retry-After.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_PUBLIC_RPS=5
RATE_LIMIT_PUBLIC_BURST=10
AUTH_LOGIN_RPS=1
AUTH_LOGIN_BURST=5
ORDERS_RPS=2
ORDERS_BURST=5

# Tracing (ADR-0012): OTLP/gRPC to the collector; empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
