SERVICE_NAME=gateway
PORT=8080
LOG_LEVEL=info

# Routing and JWT validation (RFC 0002 §5.5). First path segment → upstream.
GATEWAY_ROUTES=auth=http://auth-service:8080,me=http://user-service:8080,orders=http://order-service:8080,events=http://inventory-service:8080
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
JWT_ISSUER=ticketpro-auth
JWT_AUDIENCE=ticketpro-api
JWKS_CACHE_TTL_S=300
JWT_CLOCK_SKEW_S=30
GATEWAY_MAX_BODY_BYTES=65536
GATEWAY_UPSTREAM_TIMEOUT_MS=5000
