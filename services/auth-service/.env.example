# auth-service runtime configuration. DEVELOPMENT ONLY: credentials are fake.
SERVICE_NAME=auth-service
PORT=8080
LOG_LEVEL=info

# Postgres (docs/padroes.md §6.1): API role (RLS) and worker role (relay, consumers, jobs).
DATABASE_URL=postgres://auth_app:auth_app_dev@auth-db:5432/auth?sslmode=disable
DATABASE_WORKER_URL=postgres://auth_worker:auth_worker_dev@auth-db:5432/auth?sslmode=disable

# AWS emulated by MiniStack (fake credentials).
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AUTH_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticketpro-auth
QUEUE_URL=http://ministack:4566/000000000000/ticketpro-auth-service
JWT_SECRET_ID=ticketpro/auth/jwt-signing-key
CONTRACTS_DIR=/app/contracts

# Outbox relay and HTTP client (RFC 0003 §5.1 defaults).
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_MS=30000
OUTBOX_CLAIM_LEASE_MS=30000
HTTP_CLIENT_TIMEOUT_MS=3000
