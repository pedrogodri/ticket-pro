# auth-db and auth-service-migrate only (ADR-0020). DEVELOPMENT ONLY: never reuse these passwords.
POSTGRES_USER=auth_owner
POSTGRES_PASSWORD=auth_owner_dev
POSTGRES_DB=auth

FLYWAY_URL=jdbc:postgresql://auth-db:5432/auth
FLYWAY_USER=auth_owner
FLYWAY_PASSWORD=auth_owner_dev
FLYWAY_CONNECT_RETRIES=10
# Placeholders used by V0001__create_roles.sql; must match the passwords in .env.example.
FLYWAY_PLACEHOLDERS_APP_PASSWORD=auth_app_dev
FLYWAY_PLACEHOLDERS_WORKER_PASSWORD=auth_worker_dev
