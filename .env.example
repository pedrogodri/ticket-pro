# Global demo configuration. DEVELOPMENT ONLY: credentials are fake and only valid for MiniStack.
# Copy to .env (git-ignored) before `docker compose up`.

AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SNS topics (one per producing domain) and SQS queues (one per consumer service).
# Deterministic in MiniStack (account 000000000000); created by infra-init (infra/terraform).
AUTH_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ingressoja-auth
USERS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ingressoja-users
ORDERS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ingressoja-orders
INVENTORY_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ingressoja-inventory
PAYMENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ingressoja-payments

GATEWAY_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-gateway
AUTH_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-auth-service
USER_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-user-service
ORDER_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-order-service
INVENTORY_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-inventory-service
PAYMENT_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-payment-service
NOTIFICATION_SERVICE_QUEUE_URL=http://ministack:4566/000000000000/ingressoja-notification-service

RECEIPTS_BUCKET=ingressoja-receipts
JWT_SECRET_ID=ingressoja/auth/jwt-signing-key

# Observability (ADR-0012)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
